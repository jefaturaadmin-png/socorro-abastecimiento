rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quién es el usuario ----------
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    // "activo" puede faltar (cuenta como activo); se acepta true o "true" por si se escribió como texto.
    function conPerfil() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().get('activo', true) in [true, 'true'];
    }
    // "rol" sin importar mayúsculas ni espacios sobrantes.
    function rol()        { return string(perfil().get('rol', '')).trim().lower(); }
    function esAdmin()    { return conPerfil() && rol() == 'admin'; }
    function esQuimico()  { return conPerfil() && rol() == 'quimico'; }
    function miFarmacia() { return perfil().farmacia; }
    // Cierre del ingreso de información que programa el administrador en el usuario:
    // cierre = { desde: fecha y hora, hasta: fecha y hora o null }. Vigente entre esas horas.
    function cerrado() {
      let c = perfil().get('cierre', null);
      return c != null && request.time >= c.desde
        && (c.get('hasta', null) == null || request.time < c.hasta);
    }

    // ---------- usuarios: solo el administrador los crea o cambia ----------
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
      // En su primer ingreso cada usuario solo puede escribir su nombre y marcar que ya cambió su contraseña.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'cambiarClave', 'claveCambiada'])
        && request.resource.data.cambiarClave == false
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 60;
      // Cada usuario puede pedir (o anular) su cambio de sucursal; solo el administrador lo aprueba.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solicitudSucursal'])
        && request.resource.data.solicitudSucursal.estado in ['pendiente', 'cancelada']
        && !cerrado();
    }

    // ---------- estado actual de cada producto en cada farmacia ----------
    // id del documento: "<FARMACIA>__<codpro>"  (o "TODAS__<codpro>")
    match /bloqueos/{id} {

      // El químico solo crea bloqueos de SU farmacia, a su nombre.
      function nuevoBloqueoQuimico() {
        let d = request.resource.data;
        return d.farmacia == miFarmacia()
          && id == miFarmacia() + '__' + d.codpro
          && d.estado == 'bloqueado'
          && d.alcance == 'farmacia'
          && d.porUid == request.auth.uid;
      }

      // El químico solo puede agregar una solicitud de reactivación pendiente.
      function soloSolicitud() {
        let s = request.resource.data.solicitud;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solicitud'])
          && s.estado == 'pendiente'
          && s.porUid == request.auth.uid;
      }

      allow read: if esAdmin()
        || (esQuimico() && (resource.data.farmacia == miFarmacia() || resource.data.farmacia == 'TODAS'));

      allow create: if esAdmin() || (esQuimico() && !cerrado() && nuevoBloqueoQuimico());

      // Reactivar (estado -> activo) solo lo hace el administrador.
      allow update: if esAdmin()
        || (esQuimico() && !cerrado() && resource.data.farmacia == miFarmacia() && (
              (resource.data.estado == 'activo' && nuevoBloqueoQuimico())
           || (resource.data.estado == 'bloqueado' && soloSolicitud())
           ));

      allow delete: if false;   // nada se borra
    }

    // ---------- proyección de compras: solo el administrador ----------
    match /proy_config/{id} { allow read, write: if esAdmin(); }
    match /proy_meses/{id} { allow read, write: if esAdmin(); }
    match /proy_elecciones/{id} { allow read, write: if esAdmin(); }
    match /proy_blobs/{id} {
      allow read, write: if esAdmin();
      match /partes/{parte} { allow read, write: if esAdmin(); }
    }

    // ---------- comparativo de precios: solo el administrador ----------
    match /comp_config/{id} { allow read, write: if esAdmin(); }
    match /comp_blobs/{id} {
      allow read, write: if esAdmin();
      match /partes/{parte} { allow read, write: if esAdmin(); }
    }

    // ---------- historial: solo se agrega, nunca se cambia ni se borra ----------
    match /historial/{id} {
      allow read: if esAdmin()
        || (esQuimico() && (resource.data.farmacia == miFarmacia() || resource.data.farmacia == 'TODAS'));

      allow create: if (esAdmin() && request.resource.data.porUid == request.auth.uid)
        || (esQuimico() && !cerrado()
            && request.resource.data.porUid == request.auth.uid
            && request.resource.data.farmacia == miFarmacia()
            && request.resource.data.tipo in ['bloqueo', 'solicitud']);

      allow update, delete: if false;
    }
  }
}
