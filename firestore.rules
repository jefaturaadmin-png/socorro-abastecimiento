rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quién es el usuario ----------
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    // "activo" puede faltar (cuenta como activo); se acepta true o "true" por si se escribió como texto.
    function conPerfil() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().get('activo', true) in [true, 'true'];
    }
    // "rol" sin importar mayúsculas ni espacios sobrantes.
    function rol()        { return string(perfil().get('rol', '')).trim().lower(); }
    function esAdmin()    { return conPerfil() && rol() == 'admin'; }
    function esQuimico()  { return conPerfil() && rol() == 'quimico'; }
    function miFarmacia() { return perfil().farmacia; }
    // Vistas que el administrador le da a un usuario (p. ej. "faltantes"); el administrador las tiene todas.
    function tieneVista(v) { return conPerfil() && (rol() == 'admin' || v in perfil().get('vistas', [])); }
    // Módulos que usan los datos de la proyección (kardex, pronósticos, mapa…): el administrador o quien tenga alguno.
    function verProy() { return tieneVista('proyeccion') || tieneVista('kardex') || tieneVista('estadistica') || tieneVista('sucursales') || tieneVista('mapa') || tieneVista('drogueria') || tieneVista('porsucursal') || tieneVista('indicadores'); }
    // Usuario de una sucursal o de droguería: tiene su propio módulo (solo lectura de los datos de la proyección).
    function conSucursal() { return conPerfil() && perfil().get('farmacia', '') != ''; }
    function leeProy() { return verProy() || conSucursal(); }
    // Quién puede publicar las listas para las sucursales (desde Atención a sucursales o al subir el kardex).
    function publica() { return tieneVista('sucursales') || tieneVista('kardex'); }
    // Cierre del ingreso de información que programa el administrador en el usuario:
    // cierre = { desde: fecha y hora, hasta: fecha y hora o null }. Vigente entre esas horas.
    function cerrado() {
      let c = perfil().get('cierre', null);
      return c != null && request.time >= c.desde
        && (c.get('hasta', null) == null || request.time < c.hasta);
    }

    // ---------- usuarios: solo el administrador los crea o cambia ----------
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
      // En su primer ingreso cada usuario solo puede escribir su nombre y marcar que ya cambió su contraseña.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'cambiarClave', 'claveCambiada'])
        && request.resource.data.cambiarClave == false
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 60;
      // Cada usuario puede pedir (o anular) su cambio de sucursal; solo el administrador lo aprueba.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solicitudSucursal'])
        && request.resource.data.solicitudSucursal.estado in ['pendiente', 'cancelada']
        && !cerrado();
    }

    // ---------- estado actual de cada producto en cada farmacia ----------
    // id del documento: "<FARMACIA>__<codpro>"  (o "TODAS__<codpro>")
    match /bloqueos/{id} {

      // El químico solo crea bloqueos de SU farmacia, a su nombre.
      function nuevoBloqueoQuimico() {
        let d = request.resource.data;
        return d.farmacia == miFarmacia()
          && id == miFarmacia() + '__' + d.codpro
          && d.estado == 'bloqueado'
          && d.alcance == 'farmacia'
          && d.porUid == request.auth.uid;
      }

      // El químico solo puede agregar una solicitud de reactivación pendiente.
      function soloSolicitud() {
        let s = request.resource.data.solicitud;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solicitud'])
          && s.estado == 'pendiente'
          && s.porUid == request.auth.uid;
      }

      // el químico ve los de su farmacia, los generales y los de droguería (que también valen para su sucursal)
      allow read: if esAdmin()
        || (esQuimico() && resource.data.farmacia in [miFarmacia(), 'TODAS', 'DROGUERIA FS']);

      allow create: if esAdmin() || (esQuimico() && !cerrado() && nuevoBloqueoQuimico());

      // Reactivar (estado -> activo) solo lo hace el administrador.
      allow update: if esAdmin()
        || (esQuimico() && !cerrado() && resource.data.farmacia == miFarmacia() && (
              (resource.data.estado == 'activo' && nuevoBloqueoQuimico())
           || (resource.data.estado == 'bloqueado' && soloSolicitud())
           ));

      allow delete: if false;   // nada se borra
    }

    // ---------- proyección de compras: el administrador o quien tenga un módulo que la use ----------
    // el kardex general (productos y stock) y la clasificación de productos (línea, genérico, familia) los leen todos
    // los usuarios: son la base de los buscadores de medicamentos
    function kardexGeneral(id) { return conPerfil() && (get(/databases/$(database)/documents/proy_config/maestro).data.asset == id
      || (exists(/databases/$(database)/documents/proy_config/clasificacion) && get(/databases/$(database)/documents/proy_config/clasificacion).data.asset == id)); }
    match /proy_config/{id} {
      allow read: if leeProy() || (id in ['maestro', 'clasificacion'] && conPerfil());
      allow write: if verProy();
    }
    match /proy_meses/{id} { allow read: if leeProy(); allow write: if verProy(); }
    match /proy_elecciones/{id} { allow read: if leeProy(); allow write: if verProy(); }
    match /proy_blobs/{id} {
      allow read: if leeProy() || kardexGeneral(id);
      allow write: if verProy();
      match /partes/{parte} {
        allow read: if leeProy() || kardexGeneral(id);
        allow write: if verProy();
      }
    }

    // ---------- comparativo de precios: el administrador o quien tenga el módulo Comparativo ----------
    match /comp_config/{id} { allow read, write: if tieneVista('comparativo'); }
    match /comp_blobs/{id} {
      allow read, write: if tieneVista('comparativo');
      match /partes/{parte} { allow read, write: if tieneVista('comparativo'); }
    }

    // ---------- faltantes de droguería: la lista la publica el administrador; responden los usuarios con la vista ----------
    match /faltantes/{id} {
      allow read: if tieneVista('faltantes') || publica();
      allow write: if publica();
    }
    match /faltantes_estado/{cod} {
      // también la ven las sucursales en "Lo que me van a atender" y Atención a sucursales
      allow read: if tieneVista('faltantes') || tieneVista('atencion') || conSucursal() || publica();
      allow create, update: if tieneVista('faltantes')
        && request.resource.data.porUid == request.auth.uid
        && request.resource.data.estado in ['descontinuado', 'agotado', 'transito', 'pendiente', 'alternativa'];
      allow delete: if tieneVista('faltantes');
    }

    // ---------- lo que se le va a atender a cada sucursal (solo lectura; lo publica el administrador) ----------
    match /atencion/{suc} {
      allow read: if (tieneVista('atencion') && (rol() == 'admin' || perfil().get('farmacia', '') == suc)) || publica();
      allow write: if publica();
    }
    // comentario de la sucursal sobre cada producto (en el módulo de cada sucursal): id "<SUCURSAL>__<codpro>"
    // lo escriben los usuarios de esa sucursal o Abastecimiento; cada sucursal ve los suyos
    function suSucursal(suc) { return esAdmin() || (conSucursal() && suc == perfil().get('farmacia', '')); }
    match /atencion_resp/{id} {
      allow read: if publica() || suSucursal(resource.data.suc);
      allow create, update: if suSucursal(request.resource.data.suc)
        && id == request.resource.data.suc + '__' + request.resource.data.codpro
        && request.resource.data.porUid == request.auth.uid
        && request.resource.data.estado in ['si_requiere', 'no_requiere', 'no_se_mueve', 'otro_medicamento', 'otros'];
      allow delete: if suSucursal(resource.data.suc);
    }

    // qué ve cada sucursal en «Lo que me van a atender» (tipos visibles y productos ocultos o mostrados aparte): lo decide el administrador
    match /aten_vis/{suc} {
      allow read: if publica() || (tieneVista('atencion') && (rol() == 'admin' || perfil().get('farmacia', '') == suc));
      allow write: if publica();
    }

    // ---------- el producto en toda la red (para el ojito de información; lo publica el administrador) ----------
    match /red/{id} {
      allow read: if conSucursal() || tieneVista('atencion') || tieneVista('faltantes') || tieneVista('pedidos') || tieneVista('evaluacion') || tieneVista('compras') || publica();
      allow write: if publica();
    }

    // ---------- productos agotados o de extrema urgencia: lo que marca droguería en cada pedido del formulario ----------
    match /urgencia_estado/{id} {
      allow read: if tieneVista('pedidos') || publica();
      allow write: if publica();
    }

    // ---------- evaluación de sucursales (una por fecha): la llena el administrador ----------
    match /evaluacion/{fecha} {
      allow read: if tieneVista('evaluacion');
      allow write: if esAdmin();
    }

    // ---------- productos que buscan los clientes: los registra quien tenga el módulo (con foto opcional) y lo ven todos los que lo tienen ----------
    match /productos_nuevos/{id} {
      allow read: if tieneVista('nuevos');
      allow create: if tieneVista('nuevos')
        && request.resource.data.porUid == request.auth.uid
        && request.resource.data.prod is string
        && request.resource.data.prod.size() >= 2 && request.resource.data.prod.size() <= 150
        && request.resource.data.estado == 'nuevo';
      // el administrador cambia el estado y su nota; los demás solo agregan "a mi sucursal también se lo pidieron"
      allow update: if esAdmin()
        || (tieneVista('nuevos') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tambien']));
      allow delete: if esAdmin() || (tieneVista('nuevos') && resource.data.porUid == request.auth.uid);
    }
    match /productos_nuevos_foto/{id} {
      allow read: if tieneVista('nuevos');
      allow create: if tieneVista('nuevos')
        && request.resource.data.porUid == request.auth.uid
        && request.resource.data.d is string
        && request.resource.data.d.size() < 900000;
      allow update: if false;
      allow delete: if esAdmin() || (tieneVista('nuevos') && resource.data.porUid == request.auth.uid);
    }

    // ---------- editor de flujogramas: lo usan el administrador y quien tenga el módulo ----------
    match /flujogramas/{id} {
      allow read, write: if tieneVista('flued');
    }

    // ---------- reemplazos del kardex (un código se deja y se trabaja con otro): los registra quien sube el kardex ----------
    match /reemplazos/{cod} {
      allow read: if conPerfil();
      allow write: if publica();
    }

    // ---------- «gestionado por droguería»: comunicado por producto que ven droguería y las sucursales ----------
    match /gestion/{cod} {
      allow read: if conPerfil();
      allow write: if publica();
    }

    // ---------- usuario → cuenta con la que entra (cuando el administrador le restablece la contraseña) ----------
    // se lee antes de iniciar sesión (solo dice qué cuenta usar, no contiene contraseñas)
    match /alias/{usuario} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---------- avisos generales: los publica el administrador y los ven todos en su menú principal ----------
    match /avisos/{id} {
      allow read: if conPerfil();
      allow write: if esAdmin();
    }

    // ---------- historial: solo se agrega, nunca se cambia ni se borra ----------
    match /historial/{id} {
      allow read: if esAdmin()
        || (esQuimico() && (resource.data.farmacia == miFarmacia() || resource.data.farmacia == 'TODAS'));

      allow create: if (esAdmin() && request.resource.data.porUid == request.auth.uid)
        || (esQuimico() && !cerrado()
            && request.resource.data.porUid == request.auth.uid
            && request.resource.data.farmacia == miFarmacia()
            && request.resource.data.tipo in ['bloqueo', 'solicitud']);

      allow update, delete: if false;
    }
  }
}
